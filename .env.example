# Copy to .env.relay on the Docker host and fill the absolute paths/image IDs.
# Keep actual credentials in separate mode-0600 files, never in this file.
MUSE_RUNTIME_ROOT=/absolute/path/to/musestation/runtime
MUSE_RELAY_NATIVE_KIT=/absolute/path/to/musestation/runtime/native-kit-v1
MUSE_RUNTIME_UID=1000
MUSE_RUNTIME_GID=1000
MUSE_DOCKER_GID=988
MUSE_BUILD_IMAGE=sha256:REPLACE_WITH_VERIFIED_COMPILER_IMAGE_ID
MUSE_PACKAGE_IMAGE=sha256:REPLACE_WITH_VERIFIED_PACKAGER_IMAGE_ID
MUSE_PROVIDER_TOKEN_FILE=/absolute/path/to/musestation/runtime/secrets/provider-token
MUSE_CONSOLE_TOKEN_FILE=/absolute/path/to/musestation/runtime/secrets/console-token
MUSE_RELAY_LAN_BIND=127.0.0.1
MUSE_RELAY_PORT=8860
# Host port remains loopback; optional provider-test profile adds temporary HTTPS.
MUSE_PROVIDER_HOST_BIND=127.0.0.1
MUSE_PROVIDER_PORT=8861
# Optional override for the digest-pinned cloudflared image in compose.yaml.
# MUSE_PROVIDER_TUNNEL_IMAGE=cloudflare/cloudflared@sha256:<verified-digest>
MUSE_EXCHANGE_POLL_SECONDS=2
MUSE_DASHBOARD_GROUP=Personal
MUSE_DASHBOARD_NAME=MuseStation
MUSE_DASHBOARD_DESCRIPTION=PS5 build server and job relay
MUSE_DASHBOARD_ICON=mdi-sony-playstation
MUSE_DASHBOARD_URL=http://REPLACE_WITH_SERVER_LAN_IP:8860
MUSE_DASHBOARD_HEALTH_URL=http://REPLACE_WITH_SERVER_LAN_IP:8860/health
# Separate install-time console inputs; these do not configure the relay.
MUSE_BUILD_MODE=hybrid
MUSE_HYBRID_PROVIDER=muse
MUSE_PHONE_PORT=0
PS5_HOST=
PS5_PORT=9021
PS5_FIRMWARE=12.40
MUSE_SERVER_URL=
# Private local copy of console-token for scripts/configure.py; never a key value.
MUSE_RELAY_TOKEN_FILE=
PS5LM_URL=
MUSE_SPEECH_URL=
MUSE_LOG_DIR=
MUSE_ARTIFACT_DIR=
MUSE_MODEL_DIR=
MUSE_AUDIO_IN_MODULE=
